<?xml version="1.0" encoding="utf-8"?>
<!--
  For hosting the test harness on IIS.

  REDCap itself never reads this file — it is here so the same folder can be
  served straight from a web root without a build or a copy step, which is what
  makes the harness testable on a tablet.

  Two things it does:

  1. Refuses to serve the PHP. IIS without a PHP handler hands .php files out as
     plain text, which would publish the module's server-side source to anyone
     who guessed the name. Nothing the harness needs is in those files.

  2. Sends the harness for a bare request to the site root, so the address to
     type on a tablet is just the hostname.

  MIME types are deliberately not declared here. IIS 10 already knows .js and
  .json, and re-adding an existing type is what produces the "Cannot add
  duplicate collection entry" 500 that makes this look broken.
-->
<configuration>
  <system.webServer>

    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".php" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <!-- A test harness, not something to be indexed or framed. -->
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The harness and the SDK change often while this is being tested; a
           cached copy on the tablet is the classic "my fix did not deploy". -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

  </system.webServer>
</configuration>
